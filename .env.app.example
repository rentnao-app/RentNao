# Images (use GHCR or your registry)
BACKEND_IMAGE=ghcr.io/OWNER/REPO-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO-frontend:latest

# Backend runtime config
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PUBLIC_API_ORIGIN=
CORS_ORIGIN=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# S3/MinIO
S3_INTERNAL_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_REGION=
S3_REQUIRED=

# SMS OTP (optional)
SMS_OTP_ENABLED=
SMS_OTP_PROVIDER=
BULKSMSBD_API_URL=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
