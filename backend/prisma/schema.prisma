datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Added Role Enum
enum UserRole {
  TENANT
  OWNER
  ADMIN
}

enum OnboardingStatus {
  PHONE_REQUIRED
  PHONE_VERIFICATION_PENDING
  PROFILE_PENDING
  UNDER_REVIEW
  COMPLETED
}

enum KycVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdentityDocumentType {
  NATIONAL_ID
  BIRTH_REGISTRATION
  PROOF_OF_OWNERSHIP
}

enum IdentifierType {
  EMAIL
  PHONE
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FamilyStatus {
  FAMILY
  BACHELOR
}

enum TenantType {
  FAMILY
  BACHELOR
  BOTH
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyType {
  APARTMENT
}

enum AreaName {
  DHANMONDI
  GULSHAN
  BANANI
  UTTARA
  MIRPUR
  MOHAMMADPUR
  BASHUNDHARA
  BADDA
}

enum BuildingFacing {
  EAST
  WEST
  NORTH
  SOUTH
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING_PAYMENT
  RENTED
  UNLISTED
  EXPIRED
}

enum RentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum IncomeRange {
  BELOW_20K
  RANGE_20K_40K
  RANGE_40K_60K
  RANGE_60K_100K
  RANGE_100K_200K
  ABOVE_200K
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  STUDENT
  RETIRED
}

enum JobCategory {
  TECHNOLOGY
  HEALTHCARE
  EDUCATION
  FINANCE
  CONSTRUCTION
  HOSPITALITY
  RETAIL
  GOVERNMENT
  SELF_EMPLOYED
  OTHER
}

enum WalletStatus {
  ACTIVE
  INACTIVE
}

enum WalletTxnDirection {
  CREDIT
  DEBIT
}

enum WalletTxnType {
  TOPUP
  LISTING_FEE
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum WalletTxnStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum ChargeStatus {
  PENDING
  SETTLED
  FAILED
  VOID
}

enum TopupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum TestimonialStatus {
  PENDING
  FLAGGED
  APPROVED
  REJECTED
  ARCHIVED
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  CLOSED
}

model User {
  user_id           String           @id @default(cuid())
  role              UserRole         @default(TENANT)
  onboarding_status OnboardingStatus @default(PHONE_VERIFICATION_PENDING)

  // Contact info (populated after verification)
  contact_email String? @unique
  contact_phone String? @unique

  // KYC verification (document-based)
  kyc_verification_status KycVerificationStatus @default(PENDING)

  // Metadata
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  is_active     Boolean   @default(true)
  last_login_at DateTime? @db.Timestamptz(6)

  // Relations
  credentials               Credentials[]
  oauth_accounts            OAuthAccount[]
  base_profile              BaseUserProfile?
  owner_profile             OwnerProfile?
  tenant_profile            TenantProfile?
  wallet_account            WalletAccount?
  charges                   Charge[]
  topup_requests            TopupRequest[]
  listing_unlocks           ListingUnlock[]
  identity_documents        UserIdentityDocument[]
  verification_submissions  VerificationSubmission?
  rental_requests_as_tenant RentalRequest[]         @relation("RentalRequestsTenant")
  conversations_as_tenant   Conversation[]          @relation("ConversationsTenant")
  conversations_as_owner    Conversation[]          @relation("ConversationsOwner")
  sent_messages             Message[]               @relation("MessagesSender")
  approved_topup_requests   TopupRequest[]          @relation("TopupApprovals")
  owner_deals               Deal[]                  @relation("OwnerDeals")
  tenant_deals              Deal[]                  @relation("TenantDeals")
  notifications             Notification[]
  discount_redemptions      DiscountRedemption[]
  discount_eligibilities    DiscountEligibleUser[]
  testimonials              Testimonial[]
}

model Credentials {
  id      String @id @default(cuid())
  user_id String

  identifier      String
  identifier_type IdentifierType
  password_hash   String

  verified_at DateTime? @db.Timestamptz(6)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([identifier_type, identifier])
  @@index([user_id])
  @@index([identifier])
}

model OAuthAccount {
  id      String @id @default(cuid())
  user_id String

  provider         OAuthProvider
  provider_user_id String

  email String?

  // OAuth tokens
  access_token     String?   @db.Text
  refresh_token    String?   @db.Text
  token_expires_at DateTime? @db.Timestamptz(6)
  token_type       String?
  scope            String?
  id_token         String?   @db.Text

  verified_at DateTime @default(now()) @db.Timestamptz(6)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
  @@index([email])
}

model BaseUserProfile {
  id      String @id @default(cuid())
  user_id String @unique

  // Personal info
  first_name    String?
  last_name     String?
  date_of_birth DateTime?    @db.Date
  gender        Gender?
  religion      String?
  profession    String?
  job_category  JobCategory?

  profile_picture_path String?

  // Location
  current_lat  Float?
  current_lng  Float?
  current_area String?

  // Transliteration (Bengali)
  full_name_bn  String?
  profession_bn String?
  religion_bn   String?
  phone_bn      String?
  nid_bn        String?

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model OwnerProfile {
  owner_id    String  @id @default(cuid())
  user_id     String  @unique
  owner_score Decimal @default(0)

  // Owner preferences
  owner_category PropertyCategory?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  user       User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  properties Property[]
}

model TenantProfile {
  tenant_id String @id @default(cuid())
  user_id   String @unique

  // Tenant-specific fields
  income_range      IncomeRange?
  employment_status EmploymentStatus?
  tenant_score      Decimal?          @default(0)
  family_status     FamilyStatus?
  family_size       Int?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  user           User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  wishlist_items Wishlist[]
}

model Property {
  property_id        String       @id @default(cuid())
  owner_id           String
  property_type      PropertyType @default(APARTMENT)
  property_size_sqft Decimal
  room_count         Decimal
  bathroom_count     Decimal
  balcony_count      Int          @default(0)
  area_name          AreaName
  exact_lat          Float
  exact_lng          Float

  // Property details
  title       String
  description String @db.Text
  address     String

  // Building features
  building_floors    Int
  building_facing    BuildingFacing
  has_lift           Boolean        @default(false)
  has_generator      Boolean        @default(false)
  has_security_guard Boolean        @default(false)
  floor_no           Int            @default(1)
  flat_no            String?

  // Transliteration (Bengali)
  property_address_bn String?
  floor_no_bn         String?
  flat_no_bn          String?

  // Property preferences
  intended_tenant_type TenantType

  created_at DateTime @default(now()) @db.Timestamptz(6)

  owner         OwnerProfile    @relation(fields: [owner_id], references: [owner_id], onDelete: Cascade)
  listings      Listing[]
  images        PropertyImage[]
  conversations Conversation[]
  deals         Deal[]

  @@index([owner_id])
}

model WalletAccount {
  id                String       @id @default(cuid())
  user_id           String       @unique
  status            WalletStatus @default(ACTIVE)
  currency          String       @default("BDT")
  available_balance Decimal      @default(0)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?    @updatedAt @db.Timestamptz(6)

  user           User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  transactions   WalletTransaction[]
  topup_requests TopupRequest[]

  @@index([status])
}

model WalletTransaction {
  id                String             @id @default(cuid())
  wallet_account_id String
  direction         WalletTxnDirection
  type              WalletTxnType
  status            WalletTxnStatus    @default(PENDING)
  amount            Decimal
  currency          String             @default("BDT")
  reference_type    String?
  reference_id      String?
  description       String?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  posted_at         DateTime?          @db.Timestamptz(6)

  wallet_account WalletAccount @relation(fields: [wallet_account_id], references: [id], onDelete: Cascade)

  @@index([wallet_account_id, created_at])
  @@index([reference_type, reference_id])
  @@index([status, created_at])
}

model FeePolicy {
  id       String @id @default(cuid())
  code     String
  version  Int
  name     String
  currency String @default("BDT")

  // Fee composition: any combination of fixed + percentage
  fixed_amount       Decimal?
  percentage         Decimal?
  percent_base_field String? // Field name to calculate percentage on (e.g., "rent")

  // Bounds
  min_amount Decimal?
  max_amount Decimal?

  is_active      Boolean   @default(true)
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)
  created_by     String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  charges Charge[]

  @@unique([code, version])
  @@index([code])
  @@index([is_active, effective_from])
}

model DiscountPolicy {
  id                       String       @id @default(cuid())
  code                     String       @unique
  fee_policy_code          String
  discount_type            DiscountType
  fixed_amount             Decimal?
  percentage               Decimal?
  min_amount               Decimal?
  max_amount               Decimal?
  max_redemptions_total    Int?
  max_redemptions_per_user Int?
  eligible_role            UserRole?
  effective_from           DateTime     @db.Timestamptz(6)
  effective_to             DateTime?    @db.Timestamptz(6)
  is_active                Boolean      @default(true)
  created_at               DateTime     @default(now()) @db.Timestamptz(6)

  eligible_users DiscountEligibleUser[]
  redemptions    DiscountRedemption[]
  charges        Charge[]

  @@index([fee_policy_code])
  @@index([is_active, effective_from])
}

model Charge {
  id                 String       @id @default(cuid())
  user_id            String
  fee_policy_id      String
  reference_type     String
  reference_id       String
  currency           String       @default("BDT")
  base_amount        Decimal
  final_amount       Decimal
  discount_policy_id String?
  discount_amount    Decimal?
  status             ChargeStatus @default(PENDING)
  failure_reason     String?
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  settled_at         DateTime?    @db.Timestamptz(6)
  updated_at         DateTime?    @updatedAt @db.Timestamptz(6)

  user                 User                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  fee_policy           FeePolicy            @relation(fields: [fee_policy_id], references: [id], onDelete: Restrict)
  discount_policy      DiscountPolicy?      @relation(fields: [discount_policy_id], references: [id], onDelete: SetNull)
  discount_redemptions DiscountRedemption[]

  @@index([user_id, created_at])
  @@index([reference_type, reference_id])
  @@index([status, created_at])
}

model DiscountEligibleUser {
  discount_policy_id String
  user_id            String
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  discount_policy DiscountPolicy @relation(fields: [discount_policy_id], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([discount_policy_id, user_id])
  @@index([user_id])
}

model DiscountRedemption {
  id                 String   @id @default(cuid())
  discount_policy_id String
  user_id            String
  charge_id          String?
  discount_amount    Decimal
  redeemed_at        DateTime @default(now()) @db.Timestamptz(6)

  discount_policy DiscountPolicy @relation(fields: [discount_policy_id], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  charge          Charge?        @relation(fields: [charge_id], references: [id], onDelete: SetNull)

  @@index([discount_policy_id, redeemed_at])
  @@index([user_id, redeemed_at])
  @@index([charge_id])
}

model TopupRequest {
  id                   String             @id @default(cuid())
  user_id              String
  wallet_account_id    String
  amount               Decimal
  bkash_number         String
  transaction_id       String             @unique
  status               TopupRequestStatus @default(PENDING)
  rejection_reason     String?
  approved_at          DateTime?          @db.Timestamptz(6)
  approved_by_admin_id String?
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?          @updatedAt @db.Timestamptz(6)

  user              User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  wallet_account    WalletAccount @relation(fields: [wallet_account_id], references: [id], onDelete: Restrict)
  approved_by_admin User?         @relation("TopupApprovals", fields: [approved_by_admin_id], references: [user_id], onDelete: SetNull)

  @@unique([user_id, transaction_id])
  @@index([user_id, created_at])
  @@index([status, created_at])
  @@index([wallet_account_id, status])
}

model Listing {
  listing_id         String        @id @default(cuid())
  property_id        String
  rent               Decimal
  listing_start_date DateTime      @db.Timestamptz(6)
  listing_end_date   DateTime?     @db.Timestamptz(6)
  listing_status     ListingStatus @default(DRAFT)
  view_count         Int           @default(0)
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?     @updatedAt @db.Timestamptz(6)

  property        Property        @relation(fields: [property_id], references: [property_id], onDelete: Cascade)
  listing_unlocks ListingUnlock[]
  wishlist_items  Wishlist[]
  rental_requests RentalRequest[]
  deals           Deal[]

  @@index([property_id])
  @@index([listing_status, listing_start_date])
}

model ListingUnlock {
  id             String   @id @default(cuid())
  listing_id     String
  tenant_user_id String
  charge_id      String?
  unlocked_at    DateTime @default(now()) @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  listing     Listing @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)
  tenant_user User    @relation(fields: [tenant_user_id], references: [user_id], onDelete: Cascade)

  @@unique([listing_id, tenant_user_id])
  @@index([listing_id])
  @@index([tenant_user_id, unlocked_at])
}

model Wishlist {
  tenant_id  String
  listing_id String
  added_at   DateTime @default(now()) @db.Timestamptz(6)

  tenant  TenantProfile @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade)
  listing Listing       @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)

  @@id([tenant_id, listing_id])
}

model RentalRequest {
  rental_request_id String              @id @default(cuid())
  listing_id        String
  tenant_user_id    String
  status            RentalRequestStatus @default(PENDING)
  message           String?             @db.Text
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @updatedAt @db.Timestamptz(6)

  listing Listing @relation(fields: [listing_id], references: [listing_id], onDelete: Cascade)
  tenant  User    @relation("RentalRequestsTenant", fields: [tenant_user_id], references: [user_id], onDelete: Cascade)

  @@index([listing_id])
  @@index([tenant_user_id])
  @@index([status])
}

model Notification {
  notification_id String   @id @default(cuid())
  user_id         String
  title           String
  message         String   @db.Text
  data            Json?
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, is_read])
}

model VerificationSubmission {
  id                String                       @id @default(cuid())
  user_id           String                       @unique
  submission_status VerificationSubmissionStatus @default(DRAFT)
  submitted_at      DateTime?                    @db.Timestamptz(6)
  reviewed_at       DateTime?                    @db.Timestamptz(6)
  reviewed_by       String? // admin userId
  rejection_reason  String?
  created_at        DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?                    @updatedAt @db.Timestamptz(6)

  user               User                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  identity_documents UserIdentityDocument[]

  @@index([user_id])
  @@index([submission_status])
  @@index([submitted_at])
}

model UserIdentityDocument {
  id                  String                     @id @default(cuid())
  user_id             String
  submission_id       String?
  document_type       IdentityDocumentType
  document_number     String?
  file_path           String?
  file_name           String?
  mime_type           String?
  file_size_bytes     Int?
  verification_status DocumentVerificationStatus @default(PENDING)
  rejection_reason    String?
  uploaded_at         DateTime                   @default(now()) @db.Timestamptz(6)
  reviewed_at         DateTime?                  @db.Timestamptz(6)
  reviewed_by         String? // admin userId
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?                  @updatedAt @db.Timestamptz(6)

  user       User                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  submission VerificationSubmission? @relation(fields: [submission_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([submission_id])
  @@index([document_type])
  @@index([verification_status])
}

model PropertyImage {
  image_id    String @id @default(cuid())
  property_id String

  // Supabase storage fields
  storage_path String
  file_name    String
  file_size    Int?
  mime_type    String?

  // Display configuration
  display_order Int     @default(0)
  is_primary    Boolean @default(false)
  alt_text      String?

  uploaded_at DateTime @default(now()) @db.Timestamptz(6)

  property Property @relation(fields: [property_id], references: [property_id], onDelete: Cascade)

  @@index([property_id])
  @@index([property_id, display_order])
}

model Testimonial {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  content    String            @db.Text
  rating     Int               @default(5)
  isFeatured Boolean           @default(false) @map("is_featured")
  status     TestimonialStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([status, isFeatured])
}

model Conversation {
  id             String             @id @default(cuid())
  property_id    String
  tenant_user_id String
  owner_user_id  String
  status         ConversationStatus @default(PENDING)
  expires_at     DateTime?          @db.Timestamptz(6)
  created_at     DateTime           @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?          @updatedAt @db.Timestamptz(6)
  closed_at      DateTime?          @db.Timestamptz(6)
  closed_by      String?

  property Property  @relation(fields: [property_id], references: [property_id], onDelete: Restrict)
  tenant   User      @relation("ConversationsTenant", fields: [tenant_user_id], references: [user_id], onDelete: Restrict)
  owner    User      @relation("ConversationsOwner", fields: [owner_user_id], references: [user_id], onDelete: Restrict)
  messages Message[]

  @@unique([property_id, tenant_user_id])
  @@index([tenant_user_id, status])
  @@index([owner_user_id, status])
  @@index([status, expires_at])
}

model Message {
  id              String   @id @default(cuid())
  conversation_id String
  sender_user_id  String
  content         String   @db.Text
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation("MessagesSender", fields: [sender_user_id], references: [user_id], onDelete: Restrict)

  @@index([conversation_id, created_at])
  @@index([sender_user_id])
}

model Deal {
  deal_id      String    @id @default(cuid())
  property_id  String
  listing_id   String?
  owner_id     String
  tenant_id    String
  document_url String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @updatedAt @db.Timestamptz(6)

  property Property @relation(fields: [property_id], references: [property_id], onDelete: Restrict)
  listing  Listing? @relation(fields: [listing_id], references: [listing_id], onDelete: SetNull)
  owner    User     @relation("OwnerDeals", fields: [owner_id], references: [user_id], onDelete: Restrict)
  tenant   User     @relation("TenantDeals", fields: [tenant_id], references: [user_id], onDelete: Restrict)

  @@index([owner_id])
  @@index([tenant_id])
  @@index([property_id])
}
