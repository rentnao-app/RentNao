# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rentnao?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (optional; required for "Continue with Google")
# In Google Cloud Console, add Authorized redirect URIs:
#   {API_ORIGIN}/auth/google/callback  e.g. http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# CORS — comma-separated allowed browser origins (SPA dev + production)
CORS_ORIGIN=http://localhost:5173,https://rentnao.co,https://www.rentnao.co

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# S3-compatible storage (MinIO/LocalStack)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rentnao-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_REGION=us-east-1
S3_REQUIRED=false